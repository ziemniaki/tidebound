--- /dev/null
+++ b/src/filesystem/portablePathApple.h
@@ -0,0 +1,25 @@
+// Keep relative game paths relative: NSURL standardization can disagree with
+// getcwd about /var versus /private/var (App Translocation) and Unicode spelling.
+#pragma once
+#import <Foundation/Foundation.h>
+#include "ghc/filesystem.hpp"
+#include <algorithm>
+
+inline std::string portableGamePath(const char *path, bool absolute) {
+    namespace fs = ghc::filesystem;
+    std::string separators(path);
+    std::replace(separators.begin(), separators.end(), '\\', '/');
+    fs::path result(separators);
+    if (absolute && result.is_relative()) {
+        result = fs::current_path() / result;
+    } else if (!absolute && result.is_absolute()) {
+        // Retain support for absolute paths inside the game directory. Resolve
+        // aliases on both sides, and strip only a complete directory prefix.
+        auto relative = fs::weakly_canonical(result).lexically_relative(fs::canonical(fs::current_path()));
+        if (!relative.empty() && *relative.begin() != "..") result = relative;
+    }
+    std::string normalized = result.lexically_normal().string();
+    NSString *native = [NSFileManager.defaultManager stringWithFileSystemRepresentation:normalized.c_str()
+                                                                               length:normalized.size()];
+    return std::string([NSFileManager.defaultManager fileSystemRepresentationWithPath:native]);
+}
